#. translators: %s: example address on this site, such as example.com/how-write-b
#: includes/class-doppelslug-settings.php:194
#, php-format
msgid "When a visitor opens an address that doesn’t exist, such as %s, WordPress looks for a published post or page whose slug starts with that text and redirects to it. If several slugs start the same way, which one the visitor lands on is left to the database."
msgstr ""

#: includes/class-doppelslug-settings.php:198
msgid "Doppelslug warns authors about lookalike slugs in the editor. The settings below control how those redirects behave and how similar two slugs must be before a warning appears."
msgstr ""

#: includes/class-doppelslug-settings.php:211
msgid "Let WordPress decide (default)"
msgstr ""

#: includes/class-doppelslug-settings.php:212
msgid "Redirects to the first matching post the database returns. When several posts match, which one wins is not defined."
msgstr ""

#: includes/class-doppelslug-settings.php:215
msgid "Redirect only when one post matches (recommended)"
msgstr ""

#: includes/class-doppelslug-settings.php:216
msgid "An address that matches a single post still redirects, and an exact slug match always wins. An address that matches several posts shows the Not Found page instead of a random post."
msgstr ""

#: includes/class-doppelslug-settings.php:219
msgid "Redirect only exact slug matches"
msgstr ""

#: includes/class-doppelslug-settings.php:220
msgid "Still finds a post that moved to a different date or parent page, but never completes a partial address."
msgstr ""

#: includes/class-doppelslug-settings.php:223
msgid "Never redirect"
msgstr ""

#: includes/class-doppelslug-settings.php:224
msgid "Addresses that don’t exist always show the Not Found page."
msgstr ""

#: includes/class-doppelslug-settings.php:239
msgid "Sensitive"
msgstr ""

#: includes/class-doppelslug-settings.php:240
msgid "Warn when slugs share their first word, for example how-to-cook-rice and how-to-fix-a-bike."
msgstr ""

#: includes/class-doppelslug-settings.php:243
msgid "Balanced (default)"
msgstr ""

#: includes/class-doppelslug-settings.php:244
msgid "Warn when another slug shares at least the first half of this one, for example how-write-book and how-write-blog."
msgstr ""

#: includes/class-doppelslug-settings.php:247
msgid "Relaxed"
msgstr ""

#: includes/class-doppelslug-settings.php:248
msgid "Warn only when slugs differ just in their last word, for example how-to-cook-rice and how-to-cook-pasta."
msgstr ""

