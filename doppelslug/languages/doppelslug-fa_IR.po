#. Plugin Name of the plugin
#: doppelslug.php:3
#: includes/class-doppelslug-settings.php:135
#: includes/class-doppelslug-settings.php:136
msgid "Doppelslug"
msgstr "Doppelslug"

#. Plugin URI of the plugin
#: doppelslug.php:4
msgid "https://github.com/ararai1991/doppelslug"
msgstr ""

#. Description of the plugin
#: doppelslug.php:5
msgid "Warns authors when a slug starts like another one, so shortened or mistyped addresses can't send visitors to the wrong post."
msgstr "وقتی نامک یک نوشته مثل نامک دیگری شروع می‌شود به نویسندگان هشدار می‌دهد، تا نشانی‌های کوتاه‌شده یا اشتباه‌تایپ‌شده بازدیدکنندگان را به نوشته‌ی اشتباه نبرند."

#. Author of the plugin
#: doppelslug.php:9
msgid "ararai1991"
msgstr ""

#. Author URI of the plugin
#: doppelslug.php:10
msgid "https://github.com/ararai1991"
msgstr ""

#: includes/class-doppelslug-editor.php:88
#: assets/js/block-editor.js:236
#: assets/js/block-editor.js:242
msgid "Lookalike URLs"
msgstr "نشانی‌های مشابه"

#: includes/class-doppelslug-editor.php:117
#: assets/js/block-editor.js:170
msgid "Checking for lookalike addresses…"
msgstr "در حال بررسی نشانی‌های مشابه…"

#: includes/class-doppelslug-report.php:38
msgid "Addresses that don’t exist are never redirected on this site, so lookalike slugs can’t send visitors to the wrong post."
msgstr "در این سایت نشانی‌هایی که وجود ندارند هرگز تغییر مسیر داده نمی‌شوند، پس نامک‌های مشابه نمی‌توانند بازدیدکنندگان را به نوشته‌ی اشتباه بفرستند."

#: includes/class-doppelslug-report.php:43
msgid "No published content has an address that starts like this one."
msgstr "نشانی هیچ محتوای منتشرشده‌ای مثل این نشانی شروع نمی‌شود."

#. translators: %s: number of posts, at least 20
#: includes/class-doppelslug-report.php:56
#, php-format
msgid "At least %s published item has an address that starts like this one."
msgid_plural "At least %s published items have addresses that start like this one."
msgstr[0] "نشانی دست‌کم %s مورد منتشرشده مثل این نشانی شروع می‌شود."
msgstr[1] "نشانی دست‌کم %s مورد منتشرشده مثل این نشانی شروع می‌شود."

#. translators: %s: number of posts
#: includes/class-doppelslug-report.php:61
#, php-format
msgid "%s published item has an address that starts like this one."
msgid_plural "%s published items have addresses that start like this one."
msgstr[0] "نشانی %s مورد منتشرشده مثل این نشانی شروع می‌شود."
msgstr[1] "نشانی %s مورد منتشرشده مثل این نشانی شروع می‌شود."

#: includes/class-doppelslug-report.php:65
msgid "Tip: make the start of the slug more distinctive, for example by putting the most specific word first."
msgstr "نکته: ابتدای نامک را متمایزتر کنید؛ مثلاً مشخص‌ترین کلمه را اول بیاورید."

#: includes/class-doppelslug-report.php:97
msgid "Another published item already uses this exact slug:"
msgid_plural "Other published items already use this exact slug:"
msgstr[0] "یک مورد منتشرشده‌ی دیگر همین نامک را دارد:"
msgstr[1] "چند مورد منتشرشده‌ی دیگر همین نامک را دارند:"

#. translators: 1: address such as example.com/how-write, 2: title of the post it leads to now
#: includes/class-doppelslug-report.php:101
#, php-format
msgid "%1$s currently leads to “%2$s”. After you publish, it will open this post instead. Posts whose addresses start with it:"
msgstr "نشانی %1$s اکنون به «%2$s» می‌رود. پس از انتشار، به‌جای آن همین نوشته باز می‌شود. نوشته‌هایی که نشانی‌شان با آن شروع می‌شود:"

#. translators: %s: address such as example.com/how-write-b
#: includes/class-doppelslug-report.php:108
#, php-format
msgid "Visitors who type %s see a Not Found page, because it matches this post and also:"
msgid_plural "Visitors who type %s see a Not Found page, because it matches this post and also these:"
msgstr[0] "بازدیدکنندگانی که %s را تایپ کنند صفحه‌ی «یافت نشد» را می‌بینند، چون این نشانی هم با این نوشته منطبق است و هم با:"
msgstr[1] "بازدیدکنندگانی که %s را تایپ کنند صفحه‌ی «یافت نشد» را می‌بینند، چون این نشانی هم با این نوشته منطبق است و هم با این‌ها:"

#. translators: %s: address such as example.com/how-write-b
#: includes/class-doppelslug-report.php:114
#, php-format
msgid "After you publish, visitors who type %s will see a Not Found page, because it will match this post and also:"
msgid_plural "After you publish, visitors who type %s will see a Not Found page, because it will match this post and also these:"
msgstr[0] "پس از انتشار، بازدیدکنندگانی که %s را تایپ کنند صفحه‌ی «یافت نشد» را خواهند دید، چون این نشانی هم با این نوشته منطبق خواهد بود و هم با:"
msgstr[1] "پس از انتشار، بازدیدکنندگانی که %s را تایپ کنند صفحه‌ی «یافت نشد» را خواهند دید، چون این نشانی هم با این نوشته منطبق خواهد بود و هم با این‌ها:"

#. translators: %s: address such as example.com/how-write-b
#: includes/class-doppelslug-report.php:120
#, php-format
msgid "Visitors who type %s could land on the following post instead of this one:"
msgid_plural "Visitors who type %s could land on one of the following posts instead of this one:"
msgstr[0] "بازدیدکنندگانی که %s را تایپ کنند ممکن است به‌جای این نوشته به نوشته‌ی زیر بروند:"
msgstr[1] "بازدیدکنندگانی که %s را تایپ کنند ممکن است به‌جای این نوشته به یکی از نوشته‌های زیر بروند:"

#: includes/class-doppelslug-report.php:143
msgid "Right now it shows a Not Found page."
msgstr "در حال حاضر صفحه‌ی «یافت نشد» نمایش داده می‌شود."

#: includes/class-doppelslug-report.php:147
msgid "Right now it opens this post."
msgstr "در حال حاضر همین نوشته باز می‌شود."

#. translators: %s: post title
#: includes/class-doppelslug-report.php:152
#, php-format
msgid "Right now it opens “%s”."
msgstr "در حال حاضر «%s» باز می‌شود."

#: includes/class-doppelslug-report.php:213
msgid "(no title)"
msgstr "(بدون عنوان)"

#: includes/class-doppelslug-rest.php:40
msgid "ID of the post being edited."
msgstr "شناسه‌ی نوشته‌ای که در حال ویرایش است."

#: includes/class-doppelslug-rest.php:46
msgid "Slug typed in the editor. Leave empty to use the title."
msgstr "نامکی که در ویرایشگر وارد شده است. برای استفاده از عنوان، خالی بگذارید."

#: includes/class-doppelslug-rest.php:52
msgid "Title typed in the editor, used when there is no slug yet."
msgstr "عنوانی که در ویرایشگر وارد شده است؛ وقتی هنوز نامکی وجود ندارد از آن استفاده می‌شود."

#: includes/class-doppelslug-rest.php:82
msgid "Post not found."
msgstr "نوشته پیدا نشد."

#: includes/class-doppelslug-settings.php:94
#: includes/class-doppelslug-settings.php:208
msgid "Addresses that don’t exist"
msgstr "نشانی‌هایی که وجود ندارند"

#: includes/class-doppelslug-settings.php:102
#: includes/class-doppelslug-settings.php:236
msgid "Warning sensitivity"
msgstr "حساسیت هشدار"

#: includes/class-doppelslug-settings.php:156
msgid "Settings"
msgstr "تنظیمات"

#: includes/class-doppelslug-settings.php:169
msgid "Sorry, you are not allowed to manage these settings."
msgstr "متأسفیم، شما اجازه‌ی مدیریت این تنظیمات را ندارید."

#. translators: %s: example address on this site, such as example.com/how-write-b
#: includes/class-doppelslug-settings.php:194
#, php-format
msgid "When a visitor opens an address that doesn’t exist, such as %s, WordPress looks for a published post or page whose slug starts with that text and redirects to it. If several slugs start the same way, which one the visitor lands on is left to the database."
msgstr "وقتی بازدیدکننده‌ای نشانی‌ای را باز می‌کند که وجود ندارد، مثل %s، وردپرس دنبال نوشته یا برگه‌ی منتشرشده‌ای می‌گردد که نامکش با همان متن شروع شود و او را به آن هدایت می‌کند. اگر چند نامک به یک شکل شروع شوند، اینکه بازدیدکننده به کدام برسد به پایگاه داده بستگی دارد."

#: includes/class-doppelslug-settings.php:198
msgid "Doppelslug warns authors about lookalike slugs in the editor. The settings below control how those redirects behave and how similar two slugs must be before a warning appears."
msgstr "Doppelslug در ویرایشگر درباره‌ی نامک‌های مشابه به نویسندگان هشدار می‌دهد. تنظیمات زیر تعیین می‌کنند این تغییر مسیرها چطور انجام شوند و دو نامک چقدر باید شبیه باشند تا هشدار نمایش داده شود."

#: includes/class-doppelslug-settings.php:211
msgid "Let WordPress decide (default)"
msgstr "تصمیم با وردپرس (پیش‌فرض)"

#: includes/class-doppelslug-settings.php:212
msgid "Redirects to the first matching post the database returns. When several posts match, which one wins is not defined."
msgstr "به اولین نوشته‌ی منطبقی که پایگاه داده برمی‌گرداند هدایت می‌کند. وقتی چند نوشته منطبق باشند، مشخص نیست کدام انتخاب شود."

#: includes/class-doppelslug-settings.php:215
msgid "Redirect only when one post matches (recommended)"
msgstr "فقط وقتی یک نوشته منطبق است هدایت شود (پیشنهادی)"

#: includes/class-doppelslug-settings.php:216
msgid "An address that matches a single post still redirects, and an exact slug match always wins. An address that matches several posts shows the Not Found page instead of a random post."
msgstr "نشانی‌ای که فقط با یک نوشته منطبق است همچنان هدایت می‌شود و تطابق کامل نامک همیشه اولویت دارد. نشانی‌ای که با چند نوشته منطبق است، به‌جای یک نوشته‌ی تصادفی صفحه‌ی «یافت نشد» را نشان می‌دهد."

#: includes/class-doppelslug-settings.php:219
msgid "Redirect only exact slug matches"
msgstr "فقط تطابق کامل نامک هدایت شود"

#: includes/class-doppelslug-settings.php:220
msgid "Still finds a post that moved to a different date or parent page, but never completes a partial address."
msgstr "نوشته‌ای را که به تاریخ یا برگه‌ی والد دیگری منتقل شده همچنان پیدا می‌کند، اما هرگز نشانی ناقص را کامل نمی‌کند."

#: includes/class-doppelslug-settings.php:223
msgid "Never redirect"
msgstr "هرگز هدایت نشود"

#: includes/class-doppelslug-settings.php:224
msgid "Addresses that don’t exist always show the Not Found page."
msgstr "نشانی‌هایی که وجود ندارند همیشه صفحه‌ی «یافت نشد» را نشان می‌دهند."

#: includes/class-doppelslug-settings.php:239
msgid "Sensitive"
msgstr "حساس"

#: includes/class-doppelslug-settings.php:240
msgid "Warn when slugs share their first word, for example how-to-cook-rice and how-to-fix-a-bike."
msgstr "وقتی کلمه‌ی اول نامک‌ها یکی است هشدار بده؛ مثلاً how-to-cook-rice و how-to-fix-a-bike."

#: includes/class-doppelslug-settings.php:243
msgid "Balanced (default)"
msgstr "متعادل (پیش‌فرض)"

#: includes/class-doppelslug-settings.php:244
msgid "Warn when another slug shares at least the first half of this one, for example how-write-book and how-write-blog."
msgstr "وقتی نامک دیگری دست‌کم نیمه‌ی اول این نامک را دارد هشدار بده؛ مثلاً how-write-book و how-write-blog."

#: includes/class-doppelslug-settings.php:247
msgid "Relaxed"
msgstr "آسان‌گیر"

#: includes/class-doppelslug-settings.php:248
msgid "Warn only when slugs differ just in their last word, for example how-to-cook-rice and how-to-cook-pasta."
msgstr "فقط وقتی هشدار بده که نامک‌ها تنها در کلمه‌ی آخر با هم فرق دارند؛ مثلاً how-to-cook-rice و how-to-cook-pasta."

#. translators: %s: sentence saying how many published items have a similar address.
#: assets/js/block-editor.js:144
#, js-format
msgid "%s Visitors who type a shortened address could land on the wrong one."
msgstr "%s بازدیدکنندگانی که نشانی کوتاه‌شده تایپ کنند ممکن است به نوشته‌ی اشتباه برسند."

#: assets/js/block-editor.js:150
msgid "Show details"
msgstr "نمایش جزئیات"

#: assets/js/block-editor.js:174
msgid "Could not check for lookalike addresses."
msgstr "بررسی نشانی‌های مشابه انجام نشد."

#: assets/js/block-editor.js:206
#: assets/js/classic-editor.js:98
msgid "Change how WordPress handles these addresses"
msgstr "تغییر نحوه‌ی برخورد وردپرس با این نشانی‌ها"
